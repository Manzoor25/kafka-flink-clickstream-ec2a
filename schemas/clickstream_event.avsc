{
  "type": "record",
  "name": "ClickstreamEvent",
  "namespace": "io.clickstream.avro",
  "doc": "Raw e-commerce clickstream event governed by Karapace Schema Registry (BACKWARD compatibility).",
  "fields": [
    {"name": "event_id", "type": "string", "doc": "UUIDv4 unique event identifier used for stateful deduplication"},
    {"name": "user_id", "type": "string", "doc": "Authenticated or anonymous shopper ID; also used as Kafka partition key"},
    {"name": "client_session_id", "type": "string", "doc": "Browser tab session identifier"},
    {"name": "event_type", "type": "string", "doc": "Funnel step: page_view | add_to_cart | checkout | purchase"},
    {"name": "product_id", "type": "string", "doc": "Catalogue SKU identifier, e.g. SKU-001"},
    {"name": "quantity", "type": "int", "default": 1, "doc": "Item quantity associated with cart or purchase action"},
    {"name": "page_url", "type": "string", "doc": "Visited path"},
    {"name": "referrer", "type": "string", "default": "direct", "doc": "Traffic acquisition source"},
    {"name": "device_type", "type": "string", "default": "desktop", "doc": "desktop | mobile | tablet"},
    {"name": "country", "type": "string", "default": "US", "doc": "ISO-3166 alpha-2 country code"},
    {"name": "event_time_ms", "type": "long", "doc": "Client event occurrence timestamp in epoch milliseconds"},
    {"name": "created_at_ms", "type": "long", "doc": "Producer emission wall-clock timestamp in epoch milliseconds for end-to-end freshness"}
  ]
}
