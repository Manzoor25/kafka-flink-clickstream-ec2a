          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT if(sum(view_users) = 0, 0.0, round(sum(purchase_users) * 100.0 / sum(view_users), 2)) AS conv_pct FROM clickstream.funnel_metrics FINAL WHERE window_time >= now() - INTERVAL 1 HOUR",
