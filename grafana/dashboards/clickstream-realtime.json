      "options": {
        "showHeader": true
      },
      "title": "Top-10 Products in Latest Window (Temporal Catalogue Price Join)",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-serving"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "WITH latest_win AS (SELECT max(window_start_ms) AS w FROM clickstream.top_products FINAL WHERE window_time >= now() - INTERVAL 1 HOUR) SELECT rank_num AS rank, product_id, product_name, category, round(unit_price_avg, 2) AS avg_temporal_price_usd, page_views, cart_adds, purchases, round(product_revenue, 2) AS revenue_usd FROM clickstream.top_products FINAL WHERE window_start_ms = (SELECT w FROM latest_win) ORDER BY rank_num ASC LIMIT 10",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-serving"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "session_revenue_usd" },
            "properties": [{ "id": "unit", "value": "currencyUSD" }]
          }
        ]
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 },
      "id": 11,
      "options": {
        "showHeader": true
      },
      "title": "Sessionisation by Device & Country (30s Inactivity Session Windows)",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-serving"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT device_type, country, count() AS sessions, round(avg(duration_sec), 1) AS avg_duration_sec, round(avg(event_count), 1) AS avg_events, round(sum(converted) * 100.0 / greatest(count(), 1), 1) AS session_conv_pct, round(sum(session_revenue), 2) AS session_revenue_usd FROM clickstream.user_sessions FINAL WHERE session_time >= now() - INTERVAL 1 HOUR GROUP BY device_type, country ORDER BY session_revenue_usd DESC LIMIT 10",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-serving"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 21 },
      "id": 12,
      "options": {
        "showHeader": true
      },
      "title": "DataStream Job: Shopper Loyalty State & Late-Event Side Output",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-serving"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT query_version, loyalty_tier, count() AS deduplicated_events, uniqExact(user_id) AS users, round(quantileExact(0.50)(flink_latency_ms), 0) AS flink_p50_ms, round(quantileExact(0.50)(e2e_freshness_ms), 0) AS e2e_p50_ms, round(quantileExact(0.95)(e2e_freshness_ms), 0) AS e2e_p95_ms, (SELECT count() FROM clickstream.late_events FINAL) AS total_late_side_output FROM clickstream.freshness_probes FINAL WHERE $__timeFilter(created_time) GROUP BY query_version, loyalty_tier ORDER BY deduplicated_events DESC",
          "refId": "A"
        }
      ]
    }
