          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT window_time AS time, round(gross_revenue, 2) AS revenue_usd, toFloat64(purchases) AS purchases FROM clickstream.revenue_per_minute FINAL WHERE $__timeFilter(window_time) ORDER BY time ASC",
