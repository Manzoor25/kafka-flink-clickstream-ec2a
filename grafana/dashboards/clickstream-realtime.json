      "title": "Live Event Throughput & p95 End-to-End Freshness (5s Buckets)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-serving"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfInterval(created_time, INTERVAL 5 SECOND) AS time, toFloat64(count()) AS events_5s, toFloat64(uniqExact(user_id)) AS active_users_5s, round(quantileExact(0.95)(e2e_freshness_ms), 0) AS freshness_p95_ms FROM clickstream.freshness_probes FINAL WHERE $__timeFilter(created_time) GROUP BY time ORDER BY time ASC",
          "refId": "A"
        }
      ]
