      "gridPos": { "h": 9, "w": 10, "x": 0, "y": 12 },
      "id": 9,
      "options": {
        "showHeader": true
      },
      "title": "Causal Conversion Funnel & Step Drop-Off (MATCH_RECOGNIZE)",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-serving"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "WITH totals AS (SELECT sum(view_users) AS v, sum(cart_users) AS c, sum(checkout_users) AS k, sum(purchase_users) AS p FROM clickstream.funnel_metrics FINAL WHERE window_time >= now() - INTERVAL 1 HOUR) SELECT arrayJoin([tuple(1, '1. Product View', v, 0.0, 100.0), tuple(2, '2. Add to Cart', c, if(v=0, 0.0, round((v-c)*100.0/v, 1)), if(v=0, 0.0, round(c*100.0/v, 1))), tuple(3, '3. Checkout', k, if(c=0, 0.0, round((c-k)*100.0/c, 1)), if(v=0, 0.0, round(k*100.0/v, 1))), tuple(4, '4. Purchase', p, if(k=0, 0.0, round((k-p)*100.0/k, 1)), if(v=0, 0.0, round(p*100.0/v, 1)))]) AS s, s.2 AS funnel_step, s.3 AS distinct_users, s.4 AS step_dropoff_pct, s.5 AS cumulative_conv_pct FROM totals ORDER BY s.1 ASC",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "s": true }
          }
        }
      ]
